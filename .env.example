# Copy this file to .env.local and fill in your own values.

# Public URL of the deployed site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The password you type at /admin/login to manage products.
ADMIN_PASSWORD=change-me-please

# Random long string used to sign the admin login cookie.
# e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-a-long-random-string

# Optional: where the product database and uploaded photos live (default: ./storage).
# On a host, point this at a persistent disk so edits survive deploys.
STORAGE_DIR=
